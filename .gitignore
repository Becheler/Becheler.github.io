# Jekyll build output and caches
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby / Bundler (gems are installed in vendor/bundle, see .bundle/config)
/vendor/
Gemfile.lock
.ruby-lsp/
.ruby-version

# Node leftovers from the theme (gulp is not part of the workflow)
node_modules/
yarn.lock
package-lock.json
npm-debug.log*

# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Windows / Linux
Thumbs.db
desktop.ini
*~

# Editors (shared .vscode/tasks.json and extensions.json stay trackable)
.idea/
*.swp
*.swo
.vscode/settings.json
.vscode/*.code-workspace

# Claude Code per-machine settings
.claude/settings.local.json

# GIMP working files for doodles (export PNGs instead)
*.xcf
